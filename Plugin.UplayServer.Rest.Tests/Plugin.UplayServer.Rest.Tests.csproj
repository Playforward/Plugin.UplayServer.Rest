<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <!-- The plugin compiles against ServerShared with runtime assets excluded;
         the test host has to load it (and Serilog through it) for real. -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="ServerEmus.ServerShared" Version="0.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plugin.UplayServer.Rest/Plugin.UplayServer.Rest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
